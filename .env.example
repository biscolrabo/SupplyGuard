# Copy this file to .env and adjust the values.

# PostgreSQL connection string (Neon) used by the API and Alembic.
# Get it from the Neon console (Connection string), then:
#   - change the "postgresql://" prefix to "postgresql+psycopg://" so SQLAlchemy uses the psycopg driver
#   - keep "?sslmode=require" (Neon only accepts encrypted connections)
DATABASE_URL=postgresql+psycopg://user:password@ep-example-123456.eu-central-1.aws.neon.tech/supplyguard?sslmode=require
