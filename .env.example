# Copy this file to .env and adjust the values.

# PostgreSQL container
POSTGRES_USER=supplyguard
POSTGRES_PASSWORD=change_me
POSTGRES_DB=supplyguard

# SQLAlchemy connection string used by the API and Alembic.
# Host "db" is the service name inside Docker Compose; use "localhost" when running outside Docker.
DATABASE_URL=postgresql+psycopg://supplyguard:change_me@db:5432/supplyguard
